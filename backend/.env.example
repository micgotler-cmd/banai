APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Filled in later milestones (never commit real values):
# AI designer (Phase 5). Without a key the chat says the agent is not connected.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini (app/config.py).
OPENAI_CHAT_MODEL=
# Voice (optional; empty = defaults in app/api/voice.py: gpt-4o-mini-transcribe, gpt-4o-mini-tts, marin).
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_IMAGE_MODEL=
# Saved designs (Phase 7): https://<ref>.supabase.co and the project's secret key (sb_secret_...).
# Empty with APP_ENV=local = an in-memory store that forgets on restart; empty elsewhere = saving is off.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# HMAC key for AI proposals. Required outside APP_ENV=local (64 hex chars recommended).
PROPOSAL_SIGNING_KEY=
